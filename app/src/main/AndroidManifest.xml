<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        v1.2.0：模块 APK 不再声明任何 Activity。
        所有设置 UI 通过 WindowManager + ComposeView 直接渲染在宿主 com.mi.health 进程里。
        - 不需要桌面图标；
        - 不需要独立的进程；
        - 不需要 SYSTEM_ALERT_WINDOW 权限。
        这样用户杀后台 = 杀掉小米运动健康 = 本来就在用，模块与宿主同生共死。
    -->
    <application
        android:name=".XiaoAiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:supportsRtl="true"
        android:theme="@style/Theme.XiaoAi"
        tools:targetApi="35">

        <!--
            ★ 现代 libxposed API 模块**不需要**任何 Xposed meta-data。
            框架直接从 APK 里读这三个文件：
              META-INF/xposed/module.prop      —— minApiVersion / targetApiVersion / staticScope
              META-INF/xposed/java_init.list   —— 入口类全限定名
              META-INF/xposed/scope.list       —— 作用域包名
            模块名取 android:label，模块说明取 android:description（见上面 application 标签）。

            之前这里残留的 xposedmodule / xposeddescription / xposedminversion=82 是
            legacy API 的声明方式：在 LSPosed 1.10+ 上不但没用，还会让管理器把模块
            识别成已废弃的 legacy 模块（能勾选、但框架不会加载 → 无入口、无日志）。
            已全部移除。
        -->
    </application>

</manifest>