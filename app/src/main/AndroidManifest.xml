<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        v0.1.0-beta7：设置 UI 改为【独立 Activity】。
        之前的覆盖层方案（ComposeView 塞进宿主 Activity content）有硬伤：
          - 宿主设置页顶栏返回键走宿主自己的 popBackStack，不经过我们的 back 拦截；
          - 没有转场动画；
          - back 栈与宿主 Activity 混在一起，行为不符合直觉。
        独立 Activity 的 back / 转场 / 主题全部由系统托管，行为 = 普通页面跳转。
        入口点击（SettingsPageInjector）用显式 ComponentName 跳转，不受包可见性限制。
    -->
    <application
        android:name=".XiaoAiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:supportsRtl="true"
        android:theme="@style/Theme.XiaoAi"
        tools:targetApi="35">

        <!--
            设置页：运行在模块自己的进程。
            exported=true：宿主 com.mi.health 需要显式 ComponentName 启动它。
            singleTask：避免重复实例。
        -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|uiMode|keyboardHidden" />

        <!--
            跨进程日志通道：hook 跑在宿主（com.mi.health）进程，诊断页在模块
            进程。Android 11+ 包可见性下 createPackageContext 拿不到模块
            filesDir，所以 hook 进程用 ContentResolver.call 把日志行批量推给
            这个 provider，由它写进模块 filesDir/xiaoai.log。
            exported=true 且不设 permission：跨 uid 的宿主进程必须能调到。
            authority 固定（见 LogProvider.AUTHORITY）。
        -->
        <provider
            android:name=".core.LogProvider"
            android:authorities="com.zeroone01.xiaoai.logprovider"
            android:exported="true" />

        <!--
            ★ 现代 libxposed API 模块**不需要**任何 Xposed meta-data。
            框架直接从 APK 里读这三个文件：
              META-INF/xposed/module.prop      —— minApiVersion / targetApiVersion / staticScope
              META-INF/xposed/java_init.list   —— 入口类全限定名
              META-INF/xposed/scope.list       —— 作用域包名
            模块名取 android:label，模块说明取 android:description（见上面 application 标签）。
        -->
    </application>

</manifest>