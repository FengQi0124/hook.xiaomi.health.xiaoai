<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        注意：现代 libxposed API 下，作用域由 APK 根目录的
        `META-INF/xposed/scope.list` 声明，框架**不读**这个数组。
        保留它只是为了兼容极老的 LSPosed（legacy API 会读 xposedscope meta-data），
        两边内容必须保持一致，避免不同版本框架行为不一致。
    -->
    <string-array name="xposed_scope" translatable="false">
        <item>com.mi.health</item>
        <item>com.xiaomi.wearable</item>
        <item>com.xiaomi.hm.health</item>
    </string-array>
</resources>
